# Copy to .env and set a fresh, unpredictable secret BEFORE deploying with Docker Compose.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DEMO_ACCOUNTS_ENABLED=false
# Only for a PRIVATE local demo: enable with true and fill unique passwords.
DEMO_ADMIN_PASSWORD=
DEMO_RESPONDER_PASSWORD=

# --- Backend Settings ---
DATABASE_URL=sqlite:////app/data/disaster_triage.db
CORS_ORIGINS=["http://localhost","http://localhost:80"]
UPLOAD_DIR=/app/data/uploads

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8000
